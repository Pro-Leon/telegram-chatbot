# Telegram Bot Configuration
TELEGRAM_TOKEN=your_fan_bot_token_here
OPERATOR_BOT_TOKEN=your_operator_bot_token_here
OPERATOR_TELEGRAM_IDS=111111111,222222222

# LLM Configuration (Groq API key - can also use OpenAI key)
OPENAI_API_KEY=gsk_your_groq_key_here
EMBEDDING_API_KEY=sk-your-openai-key-if-separate

# Database Configuration
POSTGRES_DSN=postgresql://chatbot:chatbot_pass@postgres:5432/chatbot
REDIS_URL=redis://redis:6379

# Webhook Configuration
WEBHOOK_URL=https://yourdomain.com
WEBHOOK_SECRET=generate_a_long_random_string_here

# Tuning Parameters
AUTO_APPROVE_THRESHOLD=0.80
MODEL_NAME=llama-3.1-8b-instant
CHEAP_MODEL=llama-3.1-8b-instant
EMBEDDING_MODEL=text-embedding-3-small
MAX_TOKENS=200
TEMPERATURE=0.85
PRESENCE_PENALTY=0.5
FREQUENCY_PENALTY=0.3
SUMMARIZE_EVERY_N=20
DEBOUNCE_WINDOW_SECONDS=3
RATE_LIMIT_PER_MINUTE=20
USER_LOCK_TTL=60

# Database Credentials (used by docker-compose)
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot_pass
